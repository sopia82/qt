# Q-TAP System Configuration

# 1. Telegram Smartphone Notifications (Optional)
# Create a bot via @BotFather on Telegram to get token, and @userinfobot to get chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Macro Data API (Optional - FRED: Federal Reserve Economic Data)
# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 3. System Run Mode
# SIMULATION (Log & Notify only) or LIVE (Execute via Broker)
SYSTEM_MODE=SIMULATION

# 4. Risk Thresholds
MAX_SHORT_TERM_POSITIONS=4
MAX_LONG_TERM_POSITIONS=8
SHORT_TERM_STOP_LOSS_PCT=0.03
LONG_TERM_STOP_LOSS_PCT=0.07
